# ── Server ──────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string (required)
# Local Docker: postgres://reachinbox:reachinbox@localhost:5432/reachinbox
DATABASE_URL=

# ── Redis / BullMQ ────────────────────────────────────────────────────────────
# Redis URL (required). Use rediss:// for TLS (e.g. Render, Upstash)
REDIS_URL=redis://localhost:6379

# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# The URL of the deployed frontend (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ── AI — Groq ─────────────────────────────────────────────────────────────────
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Email / Ethereal ──────────────────────────────────────────────────────────
# If left empty, a free Ethereal test account is auto-provisioned on first send.
# Create a manual account at https://ethereal.email/ if you want a stable inbox.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:10000/auth/google/callback

# ── Slack OAuth (optional) ────────────────────────────────────────────────────
# https://api.slack.com/apps → OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:10000/auth/slack/callback

# ── Elasticsearch (optional) ──────────────────────────────────────────────────
# Full-text search. If unset, /api/emails/search returns [].
ELASTICSEARCH_URL=

# ── Worker Tuning ─────────────────────────────────────────────────────────────
CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=20
